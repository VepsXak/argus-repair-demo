# Сначала оставьте true: сервер примет форму, но ничего не отправит в Okdesk.
DEMO_MODE=true
PORT=3000

# Для реальной отправки:
OKDESK_ACCOUNT=argusspectrum
OKDESK_API_TOKEN=PASTE_TOKEN_HERE

# Необязательно. Если в Okdesk настроен отдельный тип заявки для ремонта,
# укажите его code. Иначе Okdesk применит тип по умолчанию.
OKDESK_ISSUE_TYPE=

# Необязательно: ID группы сервиса, если хотите назначать её сразу.
OKDESK_GROUP_ID=
